# ==================================
# Autonomous Organism - Environment Configuration
# ==================================
# Copy this file to .env and fill in the values.

# ---- Supabase (Required) ----
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# ---- AI Model (Optional) ----
# Default AI model for Puter.js and edge functions.
# If using Puter.js, this model must be available on Puter.
# If using OpenAI API in edge functions, this model must be available on OpenAI.
VITE_AI_MODEL=gpt-4o-mini

# ---- OpenAI API (For Edge Functions - Optional) ----
# If set, edge functions (run-decision, run-factory, run-growth) will use
# the OpenAI API for enhanced AI analysis. If not set, heuristic fallback is used.
OPENAI_API_KEY=sk-your-openai-api-key-here
AI_MODEL=gpt-4o-mini

# ---- Supabase Edge Function Secrets (Set in Supabase Dashboard) ----
# These are set in the Supabase Dashboard under Edge Functions > Secrets:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
# OPENAI_API_KEY=sk-your-openai-api-key-here (optional)
# AI_MODEL=gpt-4o-mini (optional)
