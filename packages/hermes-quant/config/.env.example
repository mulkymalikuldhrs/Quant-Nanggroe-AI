# =============================================================================
# HERMES QUANT OS - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your API keys.
# NEVER commit .env to version control!
# =============================================================================

# ── LLM Providers ──────────────────────────────────────────────────────────────
# Primary: NVIDIA Nemotron 70B
NVIDIA_API_KEY=nvapi-xxxxx
OPENAI_API_BASE=https://integrate.api.nvidia.com/v1

# Fallback 1: Groq (supports multiple keys for rotation)
GROQ_API_KEY=gsk_xxxxx
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=
GROQ_API_BASE=https://api.groq.com/openai/v1

# Fallback 2: OpenCode
OPENCODE_API_KEY_1=xxxxx
OPENCODE_API_KEY_2=
OPENCODE_API_BASE=https://api.opencode.ai/v1

# Model configuration
MODEL_NAME=meta/llama-3.1-nemotron-70b-instruct
GROQ_MODEL=llama-3.1-8b-instant

# ── Telegram Bot ───────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABC-xxxxx
TELEGRAM_CHAT_ID=123456789

# ── Vision API (optional, for chart_vision tool) ──────────────────────────────
OPENAI_VISION_KEY=sk-xxxxx
VISION_PROVIDER=openai

# ── Wallet Addresses (NEVER hardcode in source code) ──────────────────────────
WALLET_TRON=
WALLET_SHIBA=

# ── System Configuration ──────────────────────────────────────────────────────
LOG_DIR=./logs
DATA_DIR=./data
MAX_RESTART_ATTEMPTS=0
RESTART_DELAY=5
