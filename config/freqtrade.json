{
  "_comment": "DEPRECATED: Freqtrade is no longer used in this project. This config is retained for reference only.",
  "max_open_trades": 3,
  "stake_currency": "USDT",
  "stake_amount": 50,
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "dry_run": false,
  "exchange": {
    "name": "binance",
    "pair_whitelist": ["SOL/USDT", "ETH/USDT", "ARB/USDT", "WIF/USDT", "DOGE/USDT"],
    "ccxt_config": {"enableRateLimit": true}
  },
  "telegram": {"enabled": false, "chat_id": "", "token": ""},
  "api_server": {
    "enabled": true,
    "listen_ip_address": "127.0.0.1",
    "listen_port": 8080,
    "verbosity": "error",
    "enable_openapi": false,
    "jwt_secret_key": "${FREQTRADE_JWT_SECRET}",
    "CORS_origins": ["http://localhost:8080"],
    "username": "${FREQTRADE_USERNAME}",
    "password": "${FREQTRADE_PASSWORD}"
  }
}
