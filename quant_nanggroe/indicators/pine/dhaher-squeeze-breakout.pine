//@version=5
// DhaHer Squeeze Breakout — built from TradingView MCP bollinger_scan + volume_breakout_scanner
// Publish as invite-only on TradingView Indicator Store. TV collects payment. 0 human contact.
indicator("DhaHer Squeeze Breakout", overlay=true, max_labels_count=500)

len        = input.int(20,   "BB Length")
mult       = input.float(2.0, "BB Multiplier")
sqzThresh  = input.float(0.04, "Squeeze Threshold (BB width %)")
volMult    = input.float(2.0, "Volume Spike Multiple")
lookback   = input.int(3,    "Breakout Lookback")

// Bollinger width = squeeze proxy
basis = ta.sma(close, len)
dev   = mult * ta.stdev(close, len)
upper = basis + dev
lower = basis - dev
bbWidth = (upper - lower) / basis
sqz = bbWidth < sqzThresh

// Volume breakout
volAvg = ta.sma(volume, 20)
volSpike = volume > volAvg * volMult

// Directional breakout after squeeze
bullBreak = sqz[1] and close > math.max(open, close[1]) and close > upper and volSpike
bearBreak = sqz[1] and close < math.min(open, close[1]) and close < lower and volSpike

plotshape(bullBreak, "BUY",  shape.triangleup,   location.belowbar, color.green, size=size.small)
plotshape(bearBreak, "SELL", shape.triangledown, location.abovebar, color.red,   size=size.small)
bgcolor(sqz ? color.new(color.yellow, 85) : na, title="Squeeze Zone")
alertcondition(bullBreak, "DhaHer BUY",  "Squeeze released — bullish breakout")
alertcondition(bearBreak, "DhaHer SELL", "Squeeze released — bearish breakout")

// ponytail: one combined signal, no dashboard, no settings UI. Add multi-timeframe confluance if buyers ask.
