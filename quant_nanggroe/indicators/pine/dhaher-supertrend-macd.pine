//@version=5
// DhaHer SuperMACD — from TV MCP backtest_strategy(supertrend, macd)
indicator("DhaHer SuperMACD")
atr = ta.atr(10); up = hl2 - input.float(3.0)*atr; dn = hl2 + input.float(3.0)*atr
trend = close[1] > nz(trend[1], up) ? up : dn
[macd, sig, _] = ta.macd(close, 12, 26, 9)
long = close > trend and macd > sig
short = close < trend and macd < sig
plotshape(long and not long[1], "SM LONG", shape.triangleup, location.belowbar, color.lime, size=size.small)
plotshape(short and not short[1], "SM SHORT", shape.triangledown, location.abovebar, color.red, size=size.small)
// ponytail: hardcoded ATR mult, no input
