//@version=5
// DhaHer BB Rating — from TV MCP rating_filter (-3..+3 Bollinger rating)
indicator("DhaHer BB Rating", overlay=true)
len = input.int(20); m = input.float(2.0)
basis = ta.sma(close, len); dev = m * ta.stdev(close, len)
up = basis + dev; lo = basis - dev
rating = close > up ? 3 : close > basis ? 1 : close < lo ? -3 : -1
plotshape(rating >= 3, "STRONG BUY", shape.triangleup, location.belowbar, color.green, size=size.normal)
plotshape(rating <= -3, "STRONG SELL", shape.triangledown, location.abovebar, color.red, size=size.normal)
// ponytail: discrete rating buckets, no gradient
