# =============================================================================
# Quant-Nanggroe-AI — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your API keys.
# NEVER commit .env files to version control.
# =============================================================================

# --- LLM Provider API Keys ---
# At least one provider must be configured for live agent execution.
# Default provider is set via QNAI_LLM_PROVIDER (openai, anthropic, google, ollama, openrouter)
QNAI_OPENAI_API_KEY=
QNAI_ANTHROPIC_API_KEY=
QNAI_GOOGLE_API_KEY=
QNAI_LLM_PROVIDER=openai

# --- Market Data API Keys ---
# Alpaca: Free US equity real-time data (free tier available)
QNAI_ALPACA_API_KEY=
QNAI_ALPACA_SECRET_KEY=

# Polygon: Production-grade historical data ($29/mo)
QNAI_POLYGON_API_KEY=

# TwelveData: Global forex and equity data ($29/mo)
QNAI_TWELVEDATA_API_KEY=

# --- Database Configuration ---
QNAI_DATABASE_URL=sqlite:///data/quant.db
# Production PostgreSQL:
# QNAI_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=quant_nanggroe

# --- Redis Configuration ---
REDIS_PASSWORD=
QNAI_REDIS_URL=redis://localhost:6379/0

# --- ChromaDB Configuration ---
QNAI_CHROMA_URL=http://localhost:8001

# --- Exchange API Keys ---
# Binance (crypto)
QNAI_BINANCE_API_KEY=
QNAI_BINANCE_SECRET_KEY=

# Bybit (crypto)
QNAI_BYBIT_API_KEY=
QNAI_BYBIT_SECRET_KEY=

# --- Monitoring ---
GRAFANA_ADMIN_PASSWORD=

# --- Application Settings ---
QNAI_DEBUG=true
QNAI_ENV=development
QNAI_LOG_LEVEL=INFO
