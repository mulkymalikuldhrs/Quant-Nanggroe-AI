# =============================================================================
# Quant-Nanggroe-AI — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your API keys.
# NEVER commit .env files to version control.
# =============================================================================

# --- Alpha Vantage API Key ---
# Required for live data mode in paper daemon (free tier: 25 requests/day)
QNAI_ALPHA_VANTAGE_API_KEY=

# --- LLM Provider API Keys ---
# At least one provider must be configured for live agent execution.
# Default provider is set via QNAI_LLM_PROVIDER (openai, anthropic, google, ollama, openrouter)
QNAI_OPENAI_API_KEY=
QNAI_ANTHROPIC_API_KEY=
QNAI_GOOGLE_API_KEY=
QNAI_LLM_PROVIDER=openai

# --- Market Data API Keys ---
# Alpaca: Free US equity real-time data (free tier available)
QNAI_ALPACA_API_KEY=
QNAI_ALPACA_SECRET_KEY=

# Polygon: Production-grade historical data ($29/mo)
QNAI_POLYGON_API_KEY=

# TwelveData: Global forex and equity data ($29/mo)
QNAI_TWELVEDATA_API_KEY=

# --- Security ---
# Set these in your .env for development. NEVER use defaults in production.
QNAI_API_KEY=
QNAI_JWT_SECRET=

# --- Risk Overrides (optional — defaults match Final[] constants) ---
# QNAI_RISK_MAX_PER_TRADE=0.5
# QNAI_RISK_MAX_DAILY_LOSS=1.0
# QNAI_RISK_MAX_WEEKLY_LOSS=3.0
# QNAI_RISK_MAX_DRAWDOWN=10.0

# --- Database Configuration ---
QNAI_DATABASE_URL=sqlite:///data/quant.db
# Production PostgreSQL:
# QNAI_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=quant_nanggroe

# --- Redis Configuration ---
REDIS_PASSWORD=
QNAI_REDIS_URL=redis://localhost:6379/0

# --- ChromaDB Configuration ---
QNAI_CHROMA_URL=http://localhost:8001

# --- Exchange API Keys ---
# Binance (crypto)
QNAI_BINANCE_API_KEY=
QNAI_BINANCE_SECRET_KEY=

# Bybit (crypto)
QNAI_BYBIT_API_KEY=
QNAI_BYBIT_SECRET_KEY=

# MetaTrader 5 — multi-account (forex/CFD, Windows + live MT5 terminal).
# JSON list; role primary=failover chain. Leave empty to disable MT5.
# Example:
# QNAI_MT5_ACCOUNTS=[{"login":123456,"password":"PW","server":"MetaQuotes-Demo","role":"primary"},{"login":789,"password":"PW2","server":"Broker-Server","role":"failover"}]
QNAI_MT5_ACCOUNTS=

# --- Monitoring ---
GRAFANA_ADMIN_PASSWORD=

# --- Application Settings ---
QNAI_DEBUG=true
QNAI_ENV=development
QNAI_LOG_LEVEL=INFO

# --- QNA Credentials (replaces plaintext config files) ---
QNA_ADMIN_API_KEY=qna-your-admin-key-here
MT5_LOGIN=your-mt5-login
MT5_PASSWORD=your-mt5-password
MT5_SERVER=your-mt5-server
FREQTRADE_JWT_SECRET=your-jwt-secret
FREQTRADE_USERNAME=your-username
FREQTRADE_PASSWORD=your-password
