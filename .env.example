# =============================================================================
# Quant-Nanggroe-AI — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your API keys.
# NEVER commit .env files to version control.
# =============================================================================

# --- LLM Provider API Keys ---
# At least one provider must be configured for live agent execution.
# Default provider is set via QNAI_LLM_PROVIDER (openai, anthropic, google, ollama, openrouter)
QNAI_OPENAI_API_KEY=
QNAI_ANTHROPIC_API_KEY=
QNAI_GOOGLE_API_KEY=
QNAI_LLM_PROVIDER=openai

# --- Market Data API Keys ---
# Alpaca: Free US equity real-time data (free tier available)
QNAI_ALPACA_API_KEY=
QNAI_ALPACA_SECRET_KEY=

# Polygon: Production-grade historical data ($29/mo)
QNAI_POLYGON_API_KEY=

# TwelveData: Global forex and equity data ($29/mo)
QNAI_TWELVEDATA_API_KEY=

# --- Database Configuration ---
QNAI_DATABASE_URL=sqlite:///data/quant.db
# Production PostgreSQL:
# QNAI_DATABASE_URL=postgresql://qnai:qnai@localhost:5432/qnai

# --- Redis Configuration ---
QNAI_REDIS_URL=redis://localhost:6379/0

# --- ChromaDB Configuration ---
QNAI_CHROMA_URL=http://localhost:8001

# --- Exchange API Keys ---
# Binance (crypto)
QNAI_BINANCE_API_KEY=
QNAI_BINANCE_SECRET_KEY=

# Bybit (crypto)
QNAI_BYBIT_API_KEY=
QNAI_BYBIT_SECRET_KEY=

# --- Application Settings ---
QNAI_DEBUG=true
QNAI_ENV=development
QNAI_LOG_LEVEL=INFO

# --- Trading Safety ---
# Safe default: monitor only. Set true only after health is READY and exchange keys are verified.
QNA_TRADING_ENABLED=false

# --- ISP Bypass (SSH Relay) ---
# Route through remote SSH for Telkomsel-blocked exchanges
# QNA_SSH_USER=u0_a467
# QNA_SSH_HOST=10.210.13.229
# QNA_SSH_PORT=8022

# --- Telegram Notifications ---
# QNA_TELEGRAM_BOT_TOKEN=
# QNA_TELEGRAM_CHAT_ID=

# --- WARP (1.1.1.1) Configuration ---
# Auto-registered on first run. Config stored at:
# Linux: ~/.config/qna/warp_reg.json
# macOS: ~/Library/Application Support/qna/warp_reg.json
# Windows: %APPDATA%/qna/warp_reg.json
