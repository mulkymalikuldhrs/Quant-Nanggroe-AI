# ╔══════════════════════════════════════════════════════════════════════╗
# ║      Quant-Nanggroe-AI  —  Environment Template                     ║
# ║      Copy to .env and fill in your values. NEVER commit .env!       ║
# ╚══════════════════════════════════════════════════════════════════════╝

# ── Application ───────────────────────────────────────────────────────
APP_NAME=Quant-Nanggroe-AI
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-secure-random-string

# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://qna:qna_dev_password@localhost:5432/quant_nanggroe
DATABASE_SYNC_URL=postgresql://qna:qna_dev_password@localhost:5432/quant_nanggroe

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── QuestDB ───────────────────────────────────────────────────────────
QUESTDB_HOST=localhost
QUESTDB_PORT=8812
QUESTDB_USER=admin
QUESTDB_PASSWORD=quest

# ── LLM Providers ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-xxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxx
GROQ_API_KEY=gsk_xxxxx
NVIDIA_API_KEY=nvapi-xxxxx

# Default model for agents
DEFAULT_LLM_MODEL=gpt-4o
DEFAULT_LLM_PROVIDER=openai

# ── Data Sources ──────────────────────────────────────────────────────
POLYGON_API_KEY=xxxxx
ALPACA_API_KEY=xxxxx
ALPACA_SECRET_KEY=xxxxx
ALPHA_VANTAGE_API_KEY=xxxxx
FRED_API_KEY=xxxxx
BINANCE_API_KEY=xxxxx
BINANCE_SECRET_KEY=xxxxx

# ── Risk Limits (HARDCODED — changes here do NOT override engine defaults) ─
# These are for configuration of softer limits only.
# Constitutional limits (0.5%/trade, 1%/day, 3%/week) are hardcoded in the engine.
MAX_OPEN_POSITIONS=10
MAX_TRADES_PER_DAY=5

# ── Feature Flags ────────────────────────────────────────────────────
ENABLE_PAPER_TRADING=true
ENABLE_LIVE_TRADING=false
ENABLE_AGENTS=true
ENABLE_BACKTEST=true
ENABLE_KILL_SWITCH=true
ENABLE_AUTOSWITCH=true

# ── Telegram (Optional) ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Solana / Jupiter (Optional) ──────────────────────────────────────
SOLANA_WALLET_PRIVATE_KEY=
JUPITER_API_URL=https://quote-api.jup.ag/v6

# ── Polymarket (Optional) ────────────────────────────────────────────
POLYMARKET_API_KEY=
POLYMARKET_PRIVATE_KEY=
