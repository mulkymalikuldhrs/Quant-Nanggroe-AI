# =============================================================================
# Quant-Nanggroe-AI — Environment Variables
# =============================================================================
# DEPRECATED: Use .env.example as the canonical template.
# This file is retained for backward compatibility only.
# Copy .env.example to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# --- Application ---
QNAI_APP_NAME=Quant Nanggroe AI
QNAI_DEBUG=false
QNAI_LOG_LEVEL=INFO

# --- Database ---
QNAI_DATABASE_URL=sqlite:///data/quant_nanggroe.db
# QNAI_DATABASE_URL=postgresql+asyncpg://qnai:password@postgres:5432/qnai

# --- Redis ---
QNAI_REDIS_URL=redis://localhost:6379/0

# --- LLM API Keys ---
QNAI_OPENAI_API_KEY=
QNAI_ANTHROPIC_API_KEY=
QNAI_GOOGLE_API_KEY=
QNAI_NVIDIA_API_KEY=
QNAI_DEFAULT_LLM_PROVIDER=openai
QNAI_DEFAULT_LLM_MODEL=gpt-4o

# --- Alpaca Trading ---
QNAI_ALPACA_API_KEY=
QNAI_ALPACA_API_SECRET=
QNAI_ALPACA_PAPER=true

# --- Binance ---
QNAI_BINANCE_API_KEY=
QNAI_BINANCE_API_SECRET=

# --- Market Data ---
QNAI_ALPHA_VANTAGE_API_KEY=
QNAI_POLYGON_API_KEY=
QNAI_FRED_API_KEY=
QNAI_COINGECKO_API_KEY=
QNAI_FINNHUB_API_KEY=
QNAI_TWELVEDATA_API_KEY=
QNAI_SEC_EDGAR_USER_EMAIL=

# --- NVIDIA NIM ---
QNAI_NVIDIA_NIM_API_KEY=
QNAI_NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
QNAI_NVIDIA_NIM_DEFAULT_MODEL=meta/llama-3.1-70b-instruct

# --- Risk Limits (Constitutional) ---
QNAI_RISK_MAX_PER_TRADE=0.5
QNAI_RISK_MAX_DAILY_LOSS=1.0
QNAI_RISK_MAX_WEEKLY_LOSS=3.0
QNAI_RISK_MAX_DRAWDOWN=10.0

# --- CORS ---
QNAI_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# --- Data ---
QNAI_DATA_CACHE_TTL=300
QNAI_DATA_PROVIDER_TIMEOUT=30
